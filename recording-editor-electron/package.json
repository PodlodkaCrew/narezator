{
  "name": "cutroom-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Cutroom video and transcript editor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5178\" \"wait-on http://127.0.0.1:5178 && cross-env CUTROOM_DEV_URL=http://127.0.0.1:5178 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ffmpeg-static": "5.2.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "38.2.1",
    "electron-builder": "26.0.12",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wait-on": "9.0.1"
  },
  "build": {
    "appId": "com.cutroom.editor",
    "productName": "Cutroom",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [
      {"from": "public/recording.json", "to": "recording.json"},
      {"from": "public/waveform.json", "to": "waveform.json"},
      {"from": "public/source-captions.vtt", "to": "source-captions.vtt"}
    ],
    "asarUnpack": ["node_modules/ffmpeg-static/**/*"],
    "mac": {"category": "public.app-category.video", "target": ["dmg", "zip"]}
  }
}
